{
  "name": "@agenthub/server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentHub backend server: Fastify REST API + authentication + real-time communication",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@agenthub/agent-core": "workspace:^",
    "@agenthub/db": "workspace:*",
    "@agenthub/memory": "workspace:*",
    "@agenthub/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "prisma": "^6.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0",
    "ws": "^8.21.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  }
}
