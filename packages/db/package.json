{
  "name": "@agenthub/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database layer: Prisma schema, CRUD repositories, and seed data for AgentHub",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@agenthub/shared": "workspace:*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prisma": "^6.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:test": "DATABASE_URL=$TEST_DATABASE_URL prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio",
    "lint": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
