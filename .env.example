# ─── Database (SQLite) ────────────────────────────────────────────────────────
# 注意：SQLite 的 file: 相对路径相对「schema.prisma 所在目录」解析，不是相对 cwd。
#       schema 在 packages/db/prisma/，往上三层即仓库根，故落到 .agenthub/。
DATABASE_URL="file:../../../.agenthub/agenthub.db"
# 测试库同样相对 schema 目录，落在 packages/db/prisma/test.db（已被 .gitignore 忽略）
TEST_DATABASE_URL="file:./test.db"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8124
HOST=0.0.0.0

# ─── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:8124

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── LLM (DeepSeek) ───────────────────────────────────────────────────────────
# 注意：变量名是 LLM_BASE_URL / LLM_MODEL，不是 BASE_URL / MODEL。
#       后者是历史遗留的死键，没有任何代码读取。
API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ─── Embedding（可选；不配则退化为纯 BM25）─────────────────────────────────────
# 方式 A：本地 Ollama（零 key、零网络延迟，推荐）
#   1) brew install ollama
#   2) ollama serve
#   3) ollama pull bge-m3     # 1024 维，约 1.2GB
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=EMPTY      # Ollama 不校验，但实现要求非空
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
#
# 注意：这四个变量缺任意一个，向量路就整体关闭（**不会**用默认模型兜底）。
#       兜底会让一个拼错的 EMBEDDING_MODEL 静默把另一个向量空间写进索引。
#       未配置时启动日志会打出 "semantic recall is DISABLED"，检索仍可用
#       （只是没有语义召回，退化为纯 BM25）。
# 已知问题：bge-m3 经 Ollama 对某些技术文档会返回 NaN，缓解办法是
#          OLLAMA_FLASH_ATTENTION=false ollama serve
# EMBEDDING_QUERY_PREFIX=      # 仅非对称模型需要（bge-m3 不需要）
# EMBEDDING_DOCUMENT_PREFIX=