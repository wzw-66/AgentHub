{
  "name": "agenthub",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @agenthub/db db:generate",
    "db:push": "pnpm --filter @agenthub/db db:push",
    "db:seed": "pnpm --filter @agenthub/db db:seed",
    "db:studio": "pnpm --filter @agenthub/db db:studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  }
}
